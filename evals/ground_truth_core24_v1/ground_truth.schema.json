{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enthusiast-lens.local/schemas/hackathon-core-24-ground-truth-v1.json",
  "title": "Hackathon Core 24 frozen ground-truth fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ground_truth_version", "task_catalog_version", "fixture_id", "vehicle_family_id", "vehicle", "fixture_metadata", "facts"],
  "properties": {
    "schema_version": {"const": "hackathon-core-24-ground-truth-schema-v1"},
    "ground_truth_version": {"const": "hackathon-core-24-ground-truth-v1"},
    "task_catalog_version": {"const": "hackathon-core-24-v1"},
    "fixture_id": {"type": "string", "pattern": "^[0-9]{2}[a-z]?_.+_ground_truth\\.json$"},
    "vehicle_family_id": {"type": "string", "minLength": 1},
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "make", "model", "trim", "body_style", "transmission", "drivetrain", "market", "vin", "packages"],
      "properties": {
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "make": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "trim": {"type": "string", "minLength": 1},
        "body_style": {"type": "string", "minLength": 1},
        "transmission": {"type": "string", "minLength": 1},
        "drivetrain": {"enum": ["FWD", "RWD", "AWD", "4WD"]},
        "market": {"type": "string", "minLength": 1},
        "vin": {"type": "string", "pattern": "^[A-HJ-NPR-Z0-9]{17}$"},
        "packages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "fixture_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "frozen", "frozen_at", "configuration_match_status", "curation_method", "notes"],
      "properties": {
        "status": {"const": "frozen"},
        "frozen": {"const": true},
        "frozen_at": {"type": "string", "format": "date-time"},
        "configuration_match_status": {"const": "exact_configuration"},
        "curation_method": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "facts": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/fact"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "publisher", "source_type", "url", "configuration_match", "supports", "vpic_role"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "configuration_match": {"enum": ["exact_configuration", "exact_model_year_shared_specification"]},
        "supports": {"type": "string", "minLength": 1},
        "vpic_role": {"const": "none"},
        "evidence_path": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "applicability", "ground_truth_status", "scorable", "value", "sources"],
      "properties": {
        "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
        "applicability": {"enum": ["applicable", "not_applicable"]},
        "ground_truth_status": {"enum": ["known", "unresolved", "not_applicable"]},
        "scorable": {"type": "boolean"},
        "value": {},
        "unit": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "research_sources_reviewed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
